  "scripts": {
    "ng": "ng",
    "start": "concurrently --kill-others --names API,WEB --prefix-colors green,cyan \"npm:server\" \"npm:web\"",
    "web": "ng serve --proxy-config proxy.conf.json",
    "server": "node --watch server/index.mjs",
