{
  "name": "pacifica-farms-portal",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
  "keep_vars": true,
  // Base principal en el PostgreSQL del servidor: tunel facturacion-pc -> servicio VPC facturacion-postgres -> Hyperdrive.
  // NO descomentar suelto: se activa solo en el cambio final, despues de copiar Neon por ultima vez.
  // Mientras siga comentado, el Worker usa Neon (NEON_DATABASE_URL) como siempre.
  // "hyperdrive": [
  //   { "binding": "HYPERDRIVE", "id": "f1dcd1bae40b46149c432cab2c088d07" }
  // ],
  "assets": {
    "directory": "./dist/facturacion-clientes",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": false
  }
}
