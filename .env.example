PORT=3000
CLIENT_URL=http://localhost:4200
JWT_SECRET=reemplaza-esto-con-una-clave-larga-y-aleatoria
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=

# Neon PostgreSQL. Use the pooled connection string shown by Neon.
NEON_DATABASE_URL=

# Buzon desde el que salen los correos de facturas (ej. facturacion@cfbc.co).
# Requiere el permiso de aplicacion Mail.Send en la misma app de Azure.
MAIL_FROM=

# Oracle Object Storage (optional until the bucket is connected to the app)
OCI_AUTH_MODE=disabled
OCI_NAMESPACE=
OCI_BUCKET_NAME=facturacion-clientes-pdfs
OCI_REGION=us-chicago-1
# Use instance_principal on the Oracle VM, config or api_key locally.
OCI_CONFIG_FILE=
OCI_CONFIG_PROFILE=DEFAULT
OCI_TENANCY_ID=
OCI_USER_ID=
OCI_FINGERPRINT=
OCI_PRIVATE_KEY_PATH=
OCI_PRIVATE_KEY_PASSPHRASE=
MAIL_FROM_CENTRO=
WALMEX_DATABASE_URL=
